    "google-spreadsheet": "^5.3.0",
    "nodecg": "^2.6.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.53.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-node-externals": "^8.1.2"
